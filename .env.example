# TruePix environment configuration
# TruePix runs 100% locally and free — no API keys, no network calls, no external services.
# This file is optional and can be left empty.

# Optional local trained detector. Disabled unless a fully downloaded model
# directory is configured. The detector uses local_files_only=True and will not
# download weights during analysis.
# TRUEPIX_LOCAL_MODEL_PATH=C:\path\to\downloaded\Organika-sdxl-detector
# Optional ensemble: comma-separated paths to two or more independently
# downloaded local classifiers. Agreement raises confidence but is never proof.
# TRUEPIX_LOCAL_MODEL_PATHS=C:\models\sdxl-detector,C:\models\older-ai-detector
# Set these only when the model's config exposes opaque LABEL_0/LABEL_1 names.
# TRUEPIX_LOCAL_AI_LABEL=LABEL_0
# TRUEPIX_LOCAL_AUTHENTIC_LABEL=LABEL_1

# Optional external detector (opt-in network processing; not recommended for
# sensitive images). Leave unset for local-only processing.
# TRUEPIX_AI_API_URL=
# TRUEPIX_AI_API_KEY=
# TRUEPIX_AI_PROVIDER=